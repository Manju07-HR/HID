# ---- HID Origo (from your Postman environment, PROD values) ----
IDP_URL=https://api.origo.hidglobal.com
USERS_URL=https://api.origo.hidglobal.com/scim
CREDENTIAL_MGMT_URL=https://credential-management.api.origo.hidglobal.com
CALLBACK_URL=https://callback.api.origo.hidglobal.com
EVENTS_URL=https://event.api.origo.hidglobal.com
WPP_URL=https://web.api.origo.hidglobal.com

# ---- Your org's HID-issued credentials (from HID Professional Services) ----
ORGANIZATION_ID=your-org-id
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret
APPLICATION_ID=your-application-id

# ---- Google OAuth (from Google Cloud Console) ----
GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=https://your-frontend-domain.com

# ---- Your own app ----
FRONTEND_BASE_URL=https://your-frontend-domain.com
ORIGO_WEBHOOK_SECRET=choose-a-long-random-string

# ---- Email (for sending redemption links) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-app-password
FROM_EMAIL=you@example.com
